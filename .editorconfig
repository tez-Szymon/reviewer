root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,csproj,props,slnx,config}]
indent_size = 2

[tests/**.cs]
# Test names use Method_Scenario underscores.
dotnet_diagnostic.CA1707.severity = none

[src/**/Migrations/*.cs]
# Written by 'dotnet ef migrations add'; not hand-edited.
generated_code = true
