{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FindingsReport",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "findings"],
  "properties": {
    "summary": { "type": "string" },
    "risk": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "reason"],
          "properties": {
            "level": { "enum": ["low", "medium", "high"] },
            "reason": { "type": "string" }
          }
        },
        { "type": "null" }
      ]
    },
    "changes": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["area", "description"],
        "properties": {
          "area": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "checked": { "type": ["array", "null"], "items": { "type": "string" } },
    "notVerified": { "type": ["array", "null"], "items": { "type": "string" } },
    "earlierFindings": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "reason"],
        "properties": {
          "id": { "type": "string" },
          "status": { "enum": ["fixed", "open"] },
          "reason": { "type": "string" }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "category", "confidence", "file", "startLine", "endLine", "title", "body"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "enum": ["blocker", "major", "minor", "nit"] },
          "category": { "enum": ["security", "correctness", "performance", "tests", "maintainability", "style", "docs"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "file": { "type": "string" },
          "startLine": { "type": "integer", "minimum": 1 },
          "endLine": { "type": "integer", "minimum": 1 },
          "title": { "type": "string" },
          "body": { "type": "string" },
          "suggestion": { "type": ["string", "null"] }
        }
      }
    }
  }
}
