<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Reviewer.Desktop.ViewModels"
             xmlns:v="using:Reviewer.Desktop.Views"
             x:Class="Reviewer.Desktop.App"
             RequestedThemeVariant="Default">
  <!-- The app's own colours, light and dark; the Fluent theme has no card or status brushes of these kinds. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="CardStrokeBrush" Color="#E0E0E0" />
          <SolidColorBrush x:Key="CautionBrush" Color="#FFF4CE" />
          <SolidColorBrush x:Key="ErrorBrush" Color="#C42B1C" />
          <SolidColorBrush x:Key="CodeBrush" Color="#F3F3F3" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="CardBrush" Color="#2B2B2B" />
          <SolidColorBrush x:Key="CardStrokeBrush" Color="#3D3D3D" />
          <SolidColorBrush x:Key="CautionBrush" Color="#433519" />
          <SolidColorBrush x:Key="ErrorBrush" Color="#FF99A4" />
          <SolidColorBrush x:Key="CodeBrush" Color="#1F1F1F" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.DataTemplates>
    <DataTemplate DataType="vm:QueueViewModel"><v:QueueView /></DataTemplate>
    <DataTemplate DataType="vm:PullsViewModel"><v:PullsView /></DataTemplate>
    <DataTemplate DataType="vm:HistoryViewModel"><v:HistoryView /></DataTemplate>
    <DataTemplate DataType="vm:JobDetailViewModel"><v:JobDetailView /></DataTemplate>
    <DataTemplate DataType="vm:ReposViewModel"><v:ReposView /></DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel"><v:SettingsView /></DataTemplate>

    <!-- Settings forms: a section is a card of fields; a field is set here (ticked) or inherits. -->
    <DataTemplate DataType="vm:SettingSection">
      <Border Classes="card">
        <StackPanel Spacing="4">
          <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
          <ItemsControl ItemsSource="{Binding Fields}" />
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate DataType="vm:SettingField">
      <Grid ColumnDefinitions="230,*" ColumnSpacing="12" Margin="0,4">
        <CheckBox VerticalAlignment="Top" Content="{Binding Label}" IsChecked="{Binding IsSet}"
                  ToolTip.Tip="Ticked: set at this level. Unticked: inherits." />
        <StackPanel Grid.Column="1" Spacing="2">
          <ComboBox MinWidth="220" IsVisible="{Binding IsChoice}" IsEnabled="{Binding IsSet}"
                    ItemsSource="{Binding Options}" SelectedItem="{Binding Value}" />
          <TextBox IsVisible="{Binding IsText}" IsEnabled="{Binding IsSet}" Text="{Binding Value}"
                   AcceptsReturn="{Binding IsLines}" TextWrapping="NoWrap" />
          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding InheritedText}" />
          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding Hint}"
                     IsVisible="{Binding Hint, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
      </Grid>
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />
    <Style Selector="TextBlock.title">
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Opacity" Value="0.7" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="Border.code">
      <Setter Property="Background" Value="{DynamicResource CodeBrush}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="8" />
    </Style>
    <Style Selector="SelectableTextBlock.code">
      <Setter Property="FontFamily" Value="Menlo, Consolas, monospace" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Application.Styles>
</Application>
