<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Reviewer.Desktop.ViewModels"
             xmlns:v="using:Reviewer.Desktop.Views"
             x:Class="Reviewer.Desktop.App"
             Name="Reviewer"
             RequestedThemeVariant="Default">
  <!-- RequestedThemeVariant Default: light or dark as the OS is, switching when it does. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Reviewer.Desktop/Themes/Tokens.axaml" />
        <ResourceInclude Source="avares://Reviewer.Desktop/Themes/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.DataTemplates>
    <DataTemplate DataType="vm:QueueViewModel"><v:QueueView /></DataTemplate>
    <DataTemplate DataType="vm:PullsViewModel"><v:PullsView /></DataTemplate>
    <DataTemplate DataType="vm:HistoryViewModel"><v:HistoryView /></DataTemplate>
    <DataTemplate DataType="vm:JobDetailViewModel"><v:JobDetailView /></DataTemplate>
    <DataTemplate DataType="vm:ReposViewModel"><v:ReposView /></DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel"><v:SettingsView /></DataTemplate>

    <!-- Settings forms: a section is a card of fields; a field is set here (ticked) or inherits. -->
    <DataTemplate DataType="vm:SettingSection">
      <Border Classes="card">
        <StackPanel Spacing="4">
          <TextBlock Classes="title" Margin="0,0,0,8" Text="{Binding Title}" />
          <ItemsControl ItemsSource="{Binding Fields}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Spacing="14" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate DataType="vm:SettingField">
      <Grid ColumnDefinitions="260,*" ColumnSpacing="20">
        <StackPanel Spacing="2">
          <CheckBox VerticalAlignment="Top" FontWeight="Medium" Content="{Binding Label}" IsChecked="{Binding IsSet}"
                    ToolTip.Tip="Ticked: set at this level. Unticked: inherits." />
          <TextBlock Classes="caption" Margin="28,0,0,0" TextWrapping="Wrap" Text="{Binding Hint}"
                     IsVisible="{Binding Hint, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Top">
          <ComboBox MinWidth="240" IsVisible="{Binding IsChoice}" IsEnabled="{Binding IsSet}"
                    ItemsSource="{Binding Options}" SelectedItem="{Binding Value}" />
          <TextBox IsVisible="{Binding IsText}" IsEnabled="{Binding IsSet}" Text="{Binding Value}"
                   AcceptsReturn="{Binding IsLines}" TextWrapping="NoWrap" />
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding InheritedText}" />
        </StackPanel>
      </Grid>
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#FF4F46E5" RegionColor="#FFFAFAFA" />
        <ColorPaletteResources x:Key="Dark" Accent="#FF6366F1" RegionColor="#FF0F0F11" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://Reviewer.Desktop/Themes/Controls.axaml" />
  </Application.Styles>
</Application>
