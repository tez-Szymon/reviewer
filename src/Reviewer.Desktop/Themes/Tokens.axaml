<!--
  The design tokens: colours for light and dark (the OS picks, unless Settings › Appearance does), and the sizes every screen shares. Views use these
  keys only, never a literal colour, so a change here restyles the whole app.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <!-- Surfaces, from the window back to the raised card. -->
      <SolidColorBrush x:Key="Surface.App" Color="#FAFAFA" />
      <SolidColorBrush x:Key="Surface.Sidebar" Color="#F4F4F5" />
      <SolidColorBrush x:Key="Surface.Card" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Surface.Sunken" Color="#F4F4F5" />
      <SolidColorBrush x:Key="Surface.Hover" Color="#F4F4F5" />
      <SolidColorBrush x:Key="Surface.Selected" Color="#E4E4E7" />
      <SolidColorBrush x:Key="Stroke.Subtle" Color="#E4E4E7" />
      <SolidColorBrush x:Key="Stroke.Strong" Color="#D4D4D8" />

      <!-- Text, from headings down to hints. -->
      <SolidColorBrush x:Key="Text.Primary" Color="#18181B" />
      <SolidColorBrush x:Key="Text.Secondary" Color="#52525B" />
      <SolidColorBrush x:Key="Text.Tertiary" Color="#71717A" />
      <SolidColorBrush x:Key="Text.OnAccent" Color="#FFFFFF" />

      <SolidColorBrush x:Key="Accent.Fill" Color="#4F46E5" />
      <SolidColorBrush x:Key="Accent.Text" Color="#4338CA" />
      <SolidColorBrush x:Key="Accent.Subtle" Color="#EEF2FF" />

      <!-- Tones: what a badge or banner says at a glance. Each has a background, its text, and a solid dot. -->
      <SolidColorBrush x:Key="Tone.Neutral.Back" Color="#F4F4F5" />
      <SolidColorBrush x:Key="Tone.Neutral.Fore" Color="#3F3F46" />
      <SolidColorBrush x:Key="Tone.Neutral.Dot" Color="#A1A1AA" />
      <SolidColorBrush x:Key="Tone.Accent.Back" Color="#EEF2FF" />
      <SolidColorBrush x:Key="Tone.Accent.Fore" Color="#4338CA" />
      <SolidColorBrush x:Key="Tone.Accent.Dot" Color="#6366F1" />
      <SolidColorBrush x:Key="Tone.Success.Back" Color="#ECFDF5" />
      <SolidColorBrush x:Key="Tone.Success.Fore" Color="#047857" />
      <SolidColorBrush x:Key="Tone.Success.Dot" Color="#10B981" />
      <SolidColorBrush x:Key="Tone.Warning.Back" Color="#FFFBEB" />
      <SolidColorBrush x:Key="Tone.Warning.Fore" Color="#B45309" />
      <SolidColorBrush x:Key="Tone.Warning.Dot" Color="#F59E0B" />
      <SolidColorBrush x:Key="Tone.Danger.Back" Color="#FEF2F2" />
      <SolidColorBrush x:Key="Tone.Danger.Fore" Color="#B91C1C" />
      <SolidColorBrush x:Key="Tone.Danger.Dot" Color="#EF4444" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="Surface.App" Color="#0F0F11" />
      <SolidColorBrush x:Key="Surface.Sidebar" Color="#151518" />
      <SolidColorBrush x:Key="Surface.Card" Color="#18181B" />
      <SolidColorBrush x:Key="Surface.Sunken" Color="#111113" />
      <SolidColorBrush x:Key="Surface.Hover" Color="#232328" />
      <SolidColorBrush x:Key="Surface.Selected" Color="#2A2A30" />
      <SolidColorBrush x:Key="Stroke.Subtle" Color="#27272A" />
      <SolidColorBrush x:Key="Stroke.Strong" Color="#3F3F46" />

      <SolidColorBrush x:Key="Text.Primary" Color="#FAFAFA" />
      <SolidColorBrush x:Key="Text.Secondary" Color="#C4C4CC" />
      <SolidColorBrush x:Key="Text.Tertiary" Color="#8E8E98" />
      <SolidColorBrush x:Key="Text.OnAccent" Color="#FFFFFF" />

      <SolidColorBrush x:Key="Accent.Fill" Color="#6366F1" />
      <SolidColorBrush x:Key="Accent.Text" Color="#A5B4FC" />
      <SolidColorBrush x:Key="Accent.Subtle" Color="#1E1B4B" />

      <SolidColorBrush x:Key="Tone.Neutral.Back" Color="#27272A" />
      <SolidColorBrush x:Key="Tone.Neutral.Fore" Color="#D4D4D8" />
      <SolidColorBrush x:Key="Tone.Neutral.Dot" Color="#71717A" />
      <SolidColorBrush x:Key="Tone.Accent.Back" Color="#1E1B4B" />
      <SolidColorBrush x:Key="Tone.Accent.Fore" Color="#A5B4FC" />
      <SolidColorBrush x:Key="Tone.Accent.Dot" Color="#818CF8" />
      <SolidColorBrush x:Key="Tone.Success.Back" Color="#052E22" />
      <SolidColorBrush x:Key="Tone.Success.Fore" Color="#6EE7B7" />
      <SolidColorBrush x:Key="Tone.Success.Dot" Color="#34D399" />
      <SolidColorBrush x:Key="Tone.Warning.Back" Color="#3A2A06" />
      <SolidColorBrush x:Key="Tone.Warning.Fore" Color="#FCD34D" />
      <SolidColorBrush x:Key="Tone.Warning.Dot" Color="#FBBF24" />
      <SolidColorBrush x:Key="Tone.Danger.Back" Color="#3B0D0D" />
      <SolidColorBrush x:Key="Tone.Danger.Fore" Color="#FCA5A5" />
      <SolidColorBrush x:Key="Tone.Danger.Dot" Color="#F87171" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- Type: the app's font, and a scale of sizes. -->
  <FontFamily x:Key="Font.Mono">Menlo, Consolas, Cascadia Mono, monospace</FontFamily>
  <x:Double x:Key="Type.Display">24</x:Double>
  <x:Double x:Key="Type.Title">16</x:Double>
  <x:Double x:Key="Type.Body">13</x:Double>
  <x:Double x:Key="Type.Caption">12</x:Double>
  <x:Double x:Key="Type.Micro">11</x:Double>

  <!-- Shape. -->
  <CornerRadius x:Key="Radius.Small">4</CornerRadius>
  <CornerRadius x:Key="Radius.Medium">6</CornerRadius>
  <CornerRadius x:Key="Radius.Large">10</CornerRadius>
  <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

  <!-- Fluent's own controls take these. -->
  <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>
</ResourceDictionary>
