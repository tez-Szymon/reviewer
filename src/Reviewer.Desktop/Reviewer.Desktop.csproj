<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Not "Reviewer": file systems that ignore case would mix it up with the CLI's "reviewer" beside it. -->
    <AssemblyName>Reviewer.Desktop</AssemblyName>
    <RootNamespace>Reviewer.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The executable's icon on Windows. The macOS bundle's comes from app.icns, which eng/package.sh passes to vpk. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- UI code resumes on the UI thread after awaiting; ConfigureAwait(false) would be the bug here. -->
    <NoWarn>$(NoWarn);CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Reviewer.Desktop.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tray icons: a template for the macOS menu bar, which tints it, and a coloured one for Windows; and the
         window icon. The .icns and .ico are for the packages, not the app, so they stay out of the assembly.
         eng/icons/make-icons.sh regenerates the app icons. -->
    <AvaloniaResource Include="Assets\**" Exclude="Assets\*.icns;Assets\*.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Reviewer.Api.Client\Reviewer.Api.Client.csproj" />
    <!-- Builds the reviewer CLI next to the app, so the app can start the engine with 'reviewer serve'. -->
    <ProjectReference Include="..\Reviewer.Cli\Reviewer.Cli.csproj" />
  </ItemGroup>

</Project>
