<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Reviewer.Desktop.ViewModels"
        x:Class="Reviewer.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Reviewer"
        Width="1100" Height="720" MinWidth="720" MinHeight="480">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="16,8"
            Background="{DynamicResource CautionBrush}"
            IsVisible="{Binding !Engine.IsConnected}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Start engine"
                IsVisible="{Binding Engine.IsUnavailable}"
                Command="{Binding StartEngineCommand}" />
        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Engine.Description}" />
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="16,4">
      <DockPanel>
        <CheckBox DockPanel.Dock="Right" FontSize="12" Margin="12,0,0,0" Content="Start at login"
                  IsChecked="{Binding StartAtLogin}" IsVisible="{Binding CanStartAtLogin}"
                  ToolTip.Tip="Starts the app in the tray when you log in, with the window hidden, so reviews start with your computer." />
        <CheckBox DockPanel.Dock="Right" FontSize="12" Content="Keep the engine running after quitting"
                  IsChecked="{Binding KeepEngineRunning}"
                  ToolTip.Tip="Reviews go on without the app; it finds the engine again when it starts. An engine started elsewhere always keeps running." />
        <TextBlock DockPanel.Dock="Right" Classes="error" FontSize="12" Margin="0,0,12,0" VerticalAlignment="Center" Text="{Binding PreferencesProblem}"
                   IsVisible="{Binding PreferencesProblem, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <TextBlock DockPanel.Dock="Left" Classes="muted" FontSize="12" Margin="0,0,12,0" VerticalAlignment="Center" Text="{Binding Updates.Version}"
                   ToolTip.Tip="{Binding Updates.Problem}" />
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8" Margin="0,0,12,0" IsVisible="{Binding Updates.IsReady}">
          <TextBlock FontSize="12" VerticalAlignment="Center" Text="{Binding Updates.ReadyText}" />
          <Button FontSize="12" Padding="8,2" Content="Restart to update" Command="{Binding RestartToUpdateCommand}"
                  ToolTip.Tip="Stops an engine running from the app, even one kept running, updates the app and starts it again. Otherwise the update is applied when you quit." />
        </StackPanel>
        <TextBlock Classes="muted" FontSize="12" VerticalAlignment="Center" Text="{Binding Engine.Description}" IsVisible="{Binding Engine.IsConnected}" />
      </DockPanel>
    </Border>

    <ListBox DockPanel.Dock="Left" Width="180" Margin="8"
             ItemsSource="{Binding Pages}"
             SelectedItem="{Binding SelectedPage}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:PageViewModel">
          <TextBlock Text="{Binding Title}" Padding="4" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <ContentControl Margin="16" Content="{Binding Current}" />
  </DockPanel>
</Window>
