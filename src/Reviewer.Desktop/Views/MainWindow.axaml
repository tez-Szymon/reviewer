<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Reviewer.Desktop.ViewModels"
        xmlns:v="using:Reviewer.Desktop.Views"
        xmlns:c="using:Reviewer.Desktop.Controls"
        x:Class="Reviewer.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Reviewer"
        Icon="avares://Reviewer.Desktop/Assets/app.png"
        Width="1180" Height="760" MinWidth="820" MinHeight="520">
  <Grid ColumnDefinitions="236,*">

    <!-- The sidebar: the app, its pages, and at the foot the engine, the version and any update. -->
    <Border Background="{DynamicResource Surface.Sidebar}" BorderBrush="{DynamicResource Stroke.Subtle}" BorderThickness="0,0,1,0">
      <DockPanel Margin="12,18,12,12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="8,0,0,22">
          <Border Width="28" Height="28" CornerRadius="7" Background="{DynamicResource Accent.Fill}">
            <c:Icon Data="{StaticResource Icon.ShieldCheck}" Foreground="{DynamicResource Text.OnAccent}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Classes="title" VerticalAlignment="Center" Text="Reviewer" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="10">
          <Border Classes="card" Padding="12" IsVisible="{Binding Updates.IsReady}">
            <StackPanel Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <c:Icon Data="{StaticResource Icon.Download}" Foreground="{DynamicResource Accent.Text}" />
                <TextBlock Classes="strong" TextWrapping="Wrap" Text="{Binding Updates.ReadyText}" />
              </StackPanel>
              <Button Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      Content="Restart to update" Command="{Binding RestartToUpdateCommand}"
                      ToolTip.Tip="Stops an engine running from the app, even one kept running, updates the app and starts it again. Otherwise the update is applied when you quit." />
            </StackPanel>
          </Border>

          <Border Classes="card" Padding="12,10" ToolTip.Tip="{Binding Engine.Description}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <Ellipse Classes="dot" Classes.success="{Binding Engine.IsConnected}" Classes.danger="{Binding Engine.IsUnavailable}"
                       Classes.warning="{Binding !Engine.IsConnected}" VerticalAlignment="Top" Margin="0,5,0,0" />
              <StackPanel Grid.Column="1" Spacing="1">
                <TextBlock Classes="strong" Text="{Binding EngineHeadline}" />
                <TextBlock Classes="caption" TextTrimming="CharacterEllipsis" Text="{Binding Queue.Activity}"
                           IsVisible="{Binding Engine.IsConnected}" />
              </StackPanel>
            </Grid>
          </Border>

          <TextBlock Classes="caption" Margin="8,0,0,0" Text="{Binding Updates.Version}" ToolTip.Tip="{Binding Updates.Problem}" />
        </StackPanel>

        <ListBox Classes="nav" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:PageViewModel">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <c:Icon Data="{Binding Converter={x:Static v:PageIcons.ForPage}}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Classes="navLabel" VerticalAlignment="Center" Text="{Binding Title}" />
                <Border Grid.Column="2" Classes="count" IsVisible="{Binding Badge, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <TextBlock Text="{Binding Badge}" />
                </Border>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- The page, under a banner while there's no engine or the app's preferences couldn't be saved. -->
    <DockPanel Grid.Column="1">
      <Border DockPanel.Dock="Top" Classes="banner warning" Margin="32,20,32,0" IsVisible="{Binding !Engine.IsConnected}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
          <c:Icon Data="{StaticResource Icon.TriangleAlert}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding Engine.Description}" />
          <Button Grid.Column="2" Classes="accent" IsVisible="{Binding Engine.IsUnavailable}" Command="{Binding StartEngineCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:Icon Data="{StaticResource Icon.Play}" />
              <TextBlock Text="Start engine" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>
      <Border DockPanel.Dock="Top" Classes="banner danger" Margin="32,20,32,0"
              IsVisible="{Binding PreferencesProblem, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <c:Icon Data="{StaticResource Icon.CircleAlert}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding PreferencesProblem}" />
        </Grid>
      </Border>

      <ContentControl Margin="32,24,32,20" Content="{Binding Current}" />
    </DockPanel>
  </Grid>
</Window>
