<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Reviewer.Desktop.ViewModels"
             x:Class="Reviewer.Desktop.Views.ReposView"
             x:DataType="vm:ReposViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
      <TextBlock Classes="title" Text="Repos" />
      <TextBlock Classes="muted" TextWrapping="Wrap"
                 Text="The repos reviewer serve polls, each under repos in config.yaml. Changes edit only those keys; the file's comments and layout stay." />
      <TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <ItemsControl ItemsSource="{Binding Problems}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="x:String"><TextBlock Classes="error" Text="{Binding}" /></DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <DockPanel IsEnabled="{Binding CanEdit}">
        <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="Watch" Command="{Binding AddCommand}" />
        <TextBox PlaceholderText="Paste a repo's URL, such as https://github.com/acme/api" Text="{Binding AddUrl}" />
      </DockPanel>
      <Expander Header="Browse an account's repos" HorizontalAlignment="Stretch" IsEnabled="{Binding CanEdit}">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ComboBox Width="180" ItemsSource="{Binding Accounts}" SelectedItem="{Binding BrowseAccount}" />
            <TextBox Width="260" PlaceholderText="Owner, organization or group (optional)" Text="{Binding BrowseOwner}" />
            <Button Content="List repos" Command="{Binding BrowseCommand}" />
            <ProgressBar IsIndeterminate="True" Width="80" IsVisible="{Binding Browsing}" />
          </StackPanel>
          <ListBox x:Name="Choices" MaxHeight="240" ItemsSource="{Binding Choices}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:RepoChoiceItem">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="Watch" IsVisible="{Binding !Watched}"
                          Command="{Binding #Choices.((vm:ReposViewModel)DataContext).WatchChoiceCommand}" CommandParameter="{Binding}" />
                  <TextBlock DockPanel.Dock="Right" Classes="muted" VerticalAlignment="Center" Text="watched" IsVisible="{Binding Watched}" />
                  <TextBlock VerticalAlignment="Center" Text="{Binding Repo}" />
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Expander>
    </StackPanel>

    <Grid ColumnDefinitions="300,*" ColumnSpacing="16">
      <ListBox x:Name="Watched" ItemsSource="{Binding Watched}" SelectedItem="{Binding Selected}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:WatchedRepoItem">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Repo}" />
              <TextBlock Classes="muted" FontSize="12" Text="{Binding Details}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock Grid.Column="1" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !HasSelection}"
                 Text="Pick a repo to set what it does differently from the defaults in Settings." />
      <DockPanel Grid.Column="1" IsVisible="{Binding HasSelection}">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
            <Button Content="Revert" Command="{Binding RevertCommand}" />
            <Button Classes="accent" Content="Save" Command="{Binding SaveCommand}" />
            <Button Content="Stop watching" Command="{Binding RemoveCommand}" CommandParameter="{Binding Selected}" />
          </StackPanel>
          <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Selected.Repo}" />
        </DockPanel>
        <ScrollViewer>
          <StackPanel Spacing="12" Margin="0,0,12,0">
            <Border Classes="card">
              <ContentControl Content="{Binding Agent}" />
            </Border>
            <ItemsControl ItemsSource="{Binding Overrides}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="12" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Grid>
  </DockPanel>
</UserControl>
