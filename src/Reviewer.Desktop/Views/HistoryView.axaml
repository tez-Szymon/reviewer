<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Reviewer.Desktop.ViewModels"
             xmlns:c="using:Reviewer.Desktop.Controls"
             x:Class="Reviewer.Desktop.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">
  <DockPanel>
    <Grid DockPanel.Dock="Top" Classes="pageHeader" ColumnDefinitions="*,Auto" ColumnSpacing="24">
      <StackPanel Spacing="4">
        <TextBlock Classes="display" Text="History" />
        <TextBlock Classes="subtitle" Text="Every review, newest first, with what the policy decided and how many findings it posted." />
      </StackPanel>
    </Grid>

    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,16">
      <TextBox MaxWidth="360" HorizontalAlignment="Left" Width="360" PlaceholderText="Filter by repo" Text="{Binding RepoFilter}">
        <TextBox.InnerLeftContent>
          <c:Icon Data="{StaticResource Icon.Search}" Margin="10,0,0,0" Foreground="{DynamicResource Text.Tertiary}" />
        </TextBox.InnerLeftContent>
      </TextBox>
      <ComboBox Grid.Column="1" MinWidth="180" ItemsSource="{x:Static vm:HistoryViewModel.Outcomes}" SelectedItem="{Binding Outcome}" />
      <Button Grid.Column="2" Command="{Binding RefreshCommand}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <c:Icon Data="{StaticResource Icon.RefreshCw}" />
          <TextBlock Text="Refresh" />
        </StackPanel>
      </Button>
    </Grid>

    <Border DockPanel.Dock="Top" Classes="banner danger" Margin="0,0,0,16"
            IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
        <c:Icon Data="{StaticResource Icon.CircleAlert}" />
        <TextBlock Grid.Column="1" Text="{Binding Error}" />
      </Grid>
    </Border>

    <Border Classes="card flush" VerticalAlignment="Top">
      <Panel>
        <ProgressBar Classes="loading" VerticalAlignment="Top" IsVisible="{Binding Loading}" />

        <StackPanel Classes="empty">
          <StackPanel.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="!Jobs.Count" />
              <Binding Path="!Loading" />
            </MultiBinding>
          </StackPanel.IsVisible>
          <Border Classes="emptyIcon"><c:Icon Data="{StaticResource Icon.History}" /></Border>
          <TextBlock Classes="strong" Text="No reviews to show" />
          <TextBlock Classes="caption" Text="Finished reviews appear here. If you've filtered, try another repo or outcome." />
        </StackPanel>

        <ListBox x:Name="List" Classes="rows" ItemsSource="{Binding Jobs}" IsVisible="{Binding Jobs.Count}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:JobItem">
              <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16">
                <StackPanel Spacing="3" VerticalAlignment="Center">
                  <TextBlock Classes="strong" TextTrimming="CharacterEllipsis" Text="{Binding Pr}" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="caption" Text="{Binding Job.AgentId}" />
                    <TextBlock Classes="caption" Text="·" />
                    <TextBlock Classes="caption" Text="{Binding When}" />
                    <TextBlock Classes="caption" Text="·" IsVisible="{Binding CountsText.Length}" />
                    <TextBlock Classes="caption" Text="{Binding CountsText}" IsVisible="{Binding CountsText.Length}" />
                  </StackPanel>
                  <TextBlock Classes="error caption" Margin="0,2,0,0" Text="{Binding Error}"
                             IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
                <c:Badge Grid.Column="1" ShowDot="True" Text="{Binding StateText}" Tone="{Binding Tone}" />
                <Button Grid.Column="2" Classes="ghost" VerticalAlignment="Center"
                        Command="{Binding #List.((vm:HistoryViewModel)DataContext).OpenCommand}" CommandParameter="{Binding}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Open" />
                    <c:Icon Data="{StaticResource Icon.ChevronRight}" />
                  </StackPanel>
                </Button>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Panel>
    </Border>
  </DockPanel>
</UserControl>
